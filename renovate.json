{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [ 
    "config:recommended" 
  ],
  "regexManagers": [
    {
      "fileMatch": ["kolla/globals.yml"],
      "matchStrings": [
        "openstack_tag:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stackers-network/kolla-containers/nova-base",
      "versioningTemplate": "docker"
    }
  ]
}
