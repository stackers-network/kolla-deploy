{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "Update",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "kolla/globals.yml"
      ],
      "matchStrings": [
        "openstack_tag:\\s*\"(?<currentValue>[^\\\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stackers-network/kolla-containers/openstack-base",
      "versioningTemplate": "loose"
    }
  ]
}