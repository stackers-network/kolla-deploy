{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "kolla/globals.yml"
      ],
      "matchStrings": [
        "openstack_tag:\\s*\"(?<currentValue>[^\\\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stackers-network/kolla-containers/nova-base",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": [
        ".github/workflows/deploy-pipeline.yml"
      ],
      "matchStrings": [
        "image:\\s*ghcr\\.io/stackers-network/stn-deploy-[^:]+:(?<currentValue>[^\"]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stackers-network/stn-deploy",
      "versioningTemplate": "docker"
    }
  ]
}